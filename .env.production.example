# Production environment template for DAS.
# Copy to .env on the server and fill in every value marked "CHANGE ME".
# Never commit the real .env. See docs/deployment.md for the full runbook.

APP_NAME=DAS
APP_ENV=production
APP_KEY=                                  # CHANGE ME: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://www.example.com           # CHANGE ME: the public https URL, no trailing slash

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Daily log files plus Slack alerts for errors (critical SSR/backup problems included).
# Without a Slack webhook, set LOG_STACK=daily.
LOG_CHANNEL=stack
LOG_STACK=daily,slack
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_SLACK_WEBHOOK_URL=                    # CHANGE ME: Slack incoming-webhook URL (leave empty to disable)
LOG_SLACK_USERNAME="DAS alerts"
LOG_SLACK_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=das
DB_USERNAME=das                           # CHANGE ME: a dedicated user, not root
DB_PASSWORD=                              # CHANGE ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# First-party host(s) allowed to use cookie-based /api/v1 auth (the storefront itself).
SANCTUM_STATEFUL_DOMAINS=www.example.com,example.com   # CHANGE ME

# Shared hosting (e.g. Hostinger): no long-running processes are possible, so turn
# SSR off and let the scheduler cron run the queue. On a VPS with supervisor
# (docs/deployment.md) set INERTIA_SSR_ENABLED=true and QUEUE_WORK_FROM_SCHEDULER=false.
INERTIA_SSR_ENABLED=false
QUEUE_WORK_FROM_SCHEDULER=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database                 # requires the queue worker (docs/deployment.md)
CACHE_STORE=database

# Outgoing mail: password resets, email verification, enquiry and backup alerts.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=                                # CHANGE ME
MAIL_PORT=587
MAIL_USERNAME=                            # CHANGE ME
MAIL_PASSWORD=                            # CHANGE ME
MAIL_FROM_ADDRESS="noreply@example.com"   # CHANGE ME
MAIL_FROM_NAME="${APP_NAME}"

# Backups (spatie/laravel-backup): database dump + uploaded media, nightly.
# "local" keeps backups on this server only, which is lost with the server. For
# off-server copies use s3 (needs: composer require league/flysystem-aws-s3-v3)
# e.g. BACKUP_DISKS=local,s3, or copy storage/app/private/DAS off-server another way.
BACKUP_DISKS=local
BACKUP_NOTIFICATION_EMAIL=                # CHANGE ME: who gets backup failure alerts

AWS_ACCESS_KEY_ID=                        # CHANGE ME (backup bucket credentials)
AWS_SECRET_ACCESS_KEY=                    # CHANGE ME
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=                               # CHANGE ME
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Only needed for the one-off `php artisan das:bootstrap-mother-admin`; remove afterwards.
MOTHER_ADMIN_NAME=
MOTHER_ADMIN_EMAIL=
MOTHER_ADMIN_PASSWORD=
